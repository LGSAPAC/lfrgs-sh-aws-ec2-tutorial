<!--
	JGroups stack for Liferay Cluster Link on AWS: TCP unicast with JDBC_PING discovery.

	Based on the udp_control.xml that ships in Liferay's com.liferay.portal.cluster.multiple module,
	with UDP (multicast, not available in a VPC) replaced by TCP, and PING replaced by JDBC_PING, which
	keeps the member list in a JGROUPSPING table in the Liferay database.

	render-config.sh writes two copies, control.xml (port 7800) and transport.xml (port 7801), and
	fills in the @PLACEHOLDERS@. Do not commit a rendered copy: it contains the database password.
-->
<config
	xmlns="urn:org:jgroups"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd"
>
	<TCP
		bind_addr="@BIND_ADDR@"
		bind_port="@BIND_PORT@"
		port_range="0"
		recv_buf_size="5M"
		send_buf_size="1M"
		thread_pool.keep_alive_time="30000"
		thread_pool.max_threads="200"
		thread_pool.min_threads="0"
	/>
	<JDBC_PING
		connection_driver="org.postgresql.Driver"
		connection_password="@DB_PASSWORD@"
		connection_url="@JDBC_URL@"
		connection_username="@DB_USER@"
		initialize_sql="CREATE TABLE IF NOT EXISTS JGROUPSPING (own_addr VARCHAR(200) NOT NULL, cluster_name VARCHAR(200) NOT NULL, ping_data BYTEA, CONSTRAINT PK_JGROUPSPING PRIMARY KEY (own_addr, cluster_name))"
		remove_all_data_on_view_change="true"
	/>
	<MERGE3
		max_interval="30000"
		min_interval="10000"
	/>
	<FD_SOCK />
	<FD_ALL />
	<VERIFY_SUSPECT timeout="1500" />
	<pbcast.NAKACK2
		discard_delivered_msgs="true"
		use_mcast_xmit="false"
		xmit_interval="500"
		xmit_table_max_compaction_time="30000"
		xmit_table_msgs_per_row="2000"
		xmit_table_num_rows="100"
	/>
	<UNICAST3
		conn_expiry_timeout="0"
		xmit_interval="500"
		xmit_table_max_compaction_time="60000"
		xmit_table_msgs_per_row="2000"
		xmit_table_num_rows="100"
	/>
	<pbcast.STABLE
		desired_avg_gossip="50000"
		max_bytes="4M"
	/>
	<pbcast.GMS
		join_timeout="2000"
		print_local_addr="true"
	/>
	<UFC
		max_credits="2M"
		min_threshold="0.4"
	/>
	<MFC
		max_credits="2M"
		min_threshold="0.4"
	/>
	<FRAG2 frag_size="60K" />
	<RSVP
		resend_interval="2000"
		timeout="10000"
	/>
</config>
