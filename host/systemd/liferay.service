# Liferay DXP Tomcat bundle (Tomcat runtime). Installed by install-tomcat-bundle.sh.
[Unit]
Description=Liferay DXP (Tomcat bundle)
After=network-online.target docker.service remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=liferay
Group=liferay
EnvironmentFile=/opt/liferay-ec2/runtime/tomcat.env
# Copy the rendered portal-ext.properties, OSGi configs, JGroups files and license into Liferay home.
ExecStartPre=/bin/cp -R /opt/liferay-ec2/runtime/files/. /opt/liferay/
ExecStart=/opt/liferay/tomcat/bin/catalina.sh run
SuccessExitStatus=143
TimeoutStartSec=0
TimeoutStopSec=180
LimitNOFILE=65536
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
